# Скопировать в chat/.env и вписать ключ. .env в git не попадает.
# Нейросеть: любой OpenAI-совместимый API
AI_ENABLED=true
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# HTTP-прокси только для запросов к нейросети, пусто — как в системе (HTTPS_PROXY/ALL_PROXY)
AI_HTTP_PROXY=
AI_CHAT_MODEL=z-ai/glm-5.3-flash
AI_EMBED_MODEL=baai/bge-m3
# Усилие размышления GLM (отключить нельзя): low | medium | high
AI_REASONING=low
